{
    "compilerOptions": {
      "target": "ES6",
      "module": "CommonJS",
      "outDir": "./dist",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "jsx": "react"
    },
    "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "main.ts"
    ],
    "exclude": [
      "node_modules"
    ]
  }